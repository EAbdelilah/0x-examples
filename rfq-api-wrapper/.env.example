# 0x API Key from dashboard.0x.org
ZERO_EX_API_KEY=your_0x_api_key

# Private key for signing RFQ orders and executing fills
PRIVATE_KEY=your_private_key

# Address associated with your private key
MM_ADDRESS=0x...

# RPC URL for the chain you are providing liquidity on
# PRO TIP: Use a Private RPC (like Flashbots) to prevent MEV front-running
RPC_URL=https://...
RPC_URL_1=https://... # Ethereum Mainnet (Private RPC recommended)
RPC_URL_8453=https://... # Base
RPC_URL_137=https://... # Polygon

# Your profit margin in Basis Points (100 bps = 1%)
SPREAD_BPS=50

# Optional: Port for the express server (default: 3000)
PORT=3000

# Optional: Aggregator Router Addresses (defaults provided in code)
# ONE_INCH_ROUTER_ADDRESS=0x...
# PARASWAP_PMM_ADDRESS=0x...
# KYBERSWAP_RFQ_ADDRESS=0x...
