{
  "name": "rfq-api-wrapper",
  "version": "1.0.0",
  "description": "RFQ API Wrapper for 0x API to act as a PMM for aggregators",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "npx tsx src/index.ts",
    "maker": "npx tsx src/maker.ts",
    "filler": "npx tsx src/filler.ts",
    "dry-run": "npx tsx src/dry-run.ts",
    "simulate": "npx tsx src/simulate-trades.ts",
    "verify": "npx tsx src/verify-setup.ts",
    "dev": "npx tsx --watch src/index.ts",
    "test": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "qs": "^6.14.1",
    "viem": "^2.45.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-viem": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/hardhat-viem": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^4.2.0",
    "@types/chai-as-promised": "^7.1.6",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.1.0",
    "chai": "^4.2.0",
    "hardhat": "^2.22.1",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
